        return false;
    }
}

/**
 * Handle SignNow webhook callback
 * 
 * @param {Object} webhookData - Data from SignNow webhook
 * @returns {Promise<Object>} - Processing result
 */
export async function handleSignNowWebhook(webhookData) {
    try {
        const { event, document_id, signer_email, status } = webhookData;
        
        // Log webhook receipt
        await wixData.insert('SignNowWebhooks', {
            event,
            documentId: document_id,
            signerEmail: signer_email,
            status,
            timestamp: new Date(),
            rawData: JSON.stringify(webhookData)
        });
        
        // Handle different event types
        switch (event) {
            case 'document_complete':
                await handleDocumentComplete(webhookData);
                break;
            case 'document_viewed':
                await handleDocumentViewed(webhookData);
                break;
            case 'invite_sent':
                await handleInviteSent(webhookData);
                break;
            default:
                console.log('Unhandled webhook event:', event);
        }
        
        return { success: true, event };
        
    } catch (error) {
        console.error('Error handling webhook:', error);
        return { success: false, error: error.message };
    }
}

/**
 * Handle document completion
 */
async function handleDocumentComplete(webhookData) {
    // Update member record, send notifications, etc.
    console.log('Document completed:', webhookData.document_id);
}

/**
 * Handle document viewed
 */
async function handleDocumentViewed(webhookData) {
